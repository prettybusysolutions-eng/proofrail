#!/usr/bin/env python3
"""Dispatch a ProofRail-consumed xzenia-coder job out of process.

The dispatcher is intentionally small: ProofRail authority verification and
consumption happen before this program is invoked. This entry point verifies
the signed consumption grant against installation-owned trust roots, resolves
an installation-owned worker executable, and writes portable dispatch evidence.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import pathlib
import subprocess
import sys
import time
from typing import Any

INSTALL_ROOT = pathlib.Path(__file__).resolve().parents[1]
if str(INSTALL_ROOT) not in sys.path:
    sys.path.insert(0, str(INSTALL_ROOT))

from integrations.openclaw.repository_change import (
    RepositoryAuthorityError,
    canonical_job_digest,
    canonical_json,
    git_head,
    load_worker_registry_executor,
    parameters_from_job,
    read_canonical_job_file,
    verify_consumption_grant,
)


def read_json(path: pathlib.Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: pathlib.Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def record_digest(record: Any) -> str:
    return hashlib.sha256(canonical_json(record)).hexdigest()


def resolve_worker(consumption: dict[str, Any]) -> dict[str, str]:
    executor_id = consumption.get("executor_id")
    contract_version = consumption.get("executor_contract_version")
    executable_digest = consumption.get("executable_identity_digest")
    if not isinstance(executor_id, str) or not executor_id:
        raise SystemExit("executor_identity_missing")
    if not isinstance(contract_version, str) or not contract_version:
        raise SystemExit("executor_contract_version_missing")
    if not isinstance(executable_digest, str) or len(executable_digest) != 64:
        raise SystemExit("executor_fingerprint_missing")
    try:
        return load_worker_registry_executor(
            executor_id,
            contract_version=contract_version,
            executable_identity_digest=executable_digest,
        )
    except RepositoryAuthorityError as exc:
        raise SystemExit(str(exc)) from exc


def main() -> int:
    parser = argparse.ArgumentParser(prog="xzenia-coder-dispatch")
    parser.add_argument("--job-file", required=True, type=pathlib.Path)
    parser.add_argument("--repo-path", required=True, type=pathlib.Path)
    parser.add_argument("--output-dir", required=True, type=pathlib.Path)
    parser.add_argument("--proofrail-consumption-file", required=True, type=pathlib.Path)
    args = parser.parse_args()

    repo_path = args.repo_path.resolve()
    job = read_canonical_job_file(args.job_file, expected_repo_path=repo_path)
    job_id = str(job["job_id"])
    consumption = read_json(args.proofrail_consumption_file)
    verified_job_bytes = canonical_json(job)
    verified_job_digest = canonical_job_digest(job)
    parameters = parameters_from_job(
        job,
        repo_path=repo_path,
        base_commit_sha=git_head(repo_path),
    )
    try:
        verify_consumption_grant(
            consumption,
            parameters=parameters,
            executor_id="xzenia-coder",
        )
    except RepositoryAuthorityError as exc:
        raise SystemExit(str(exc)) from exc

    worker_spec = resolve_worker(consumption)
    dispatch_dir = args.output_dir.resolve() / "dispatch"
    dispatch_dir.mkdir(parents=True, exist_ok=True)
    stdout = dispatch_dir / "worker.stdout.log"
    stderr = dispatch_dir / "worker.stderr.log"
    with stdout.open("w", encoding="utf-8") as out, stderr.open("w", encoding="utf-8") as err:
        proc = subprocess.Popen(
            [
                worker_spec["path"],
                "run",
                "--job-stdin",
                "--repo-path",
                str(repo_path),
                "--output-dir",
                str(args.output_dir.resolve()),
            ],
            stdin=subprocess.PIPE,
            stdout=out,
            stderr=err,
            start_new_session=True,
        )
        assert proc.stdin is not None
        proc.stdin.write(verified_job_bytes)
        proc.stdin.close()
    result = {
        "job_id": job_id,
        "status": "DISPATCHED",
        "pid": proc.pid,
        "started_ms": int(time.time() * 1000),
        "evidence_directory": str(args.output_dir.resolve()),
        "original_job_file": str(args.job_file.resolve()),
        "verified_input_transport": "stdin_pipe",
        "verified_worker_input_digest": verified_job_digest,
        "resolved_executor_identity": worker_spec["executor_id"],
        "resolved_executor_contract_version": worker_spec["contract_version"],
        "resolved_executor_fingerprint": worker_spec["executable_identity_digest"],
        "authority_digest": consumption.get("authority_digest"),
        "consumption_grant_digest": record_digest(consumption),
        "stdout_log": str(stdout),
        "stderr_log": str(stderr),
        "gateway_blocking": False,
    }
    write_json(dispatch_dir / "dispatch.json", result)
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
