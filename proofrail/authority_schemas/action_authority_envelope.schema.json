{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/action_authority_envelope.schema.json",
  "title": "ProofRail Action Authority Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "envelope_id", "state", "issued_at", "expires_at", "nonce", "issuer", "subject", "roots", "approval_digest", "effect", "adapter_contract", "observation_contract", "failure_semantics", "record_hash", "signature"],
  "properties": {
    "kind": {"const": "proofrail.action-authority-envelope.v1"},
    "envelope_id": {"type": "string", "minLength": 1},
    "state": {"const": "PERMITTED"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16},
    "issuer": {"$ref": "#/$defs/principal"},
    "subject": {"$ref": "#/$defs/principal"},
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "evidence", "policy", "state"],
      "properties": {
        "identity": {"$ref": "#/$defs/digest"},
        "evidence": {"$ref": "#/$defs/digest"},
        "policy": {"$ref": "#/$defs/digest"},
        "state": {"$ref": "#/$defs/digest"}
      }
    },
    "approval_digest": {"$ref": "#/$defs/digest"},
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_type", "target", "parameters", "effect_digest"],
      "properties": {
        "action_type": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "effect_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "constraints": {"type": "object"},
    "adapter_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "idempotency_required"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "idempotency_required": {"const": true}
      }
    },
    "observation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "minimum_confirmations", "success_predicate_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "minimum_confirmations": {"type": "integer", "minimum": 1},
        "success_predicate_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consume_before_effect", "ambiguous_outcome", "retry"],
      "properties": {
        "consume_before_effect": {"const": true},
        "ambiguous_outcome": {"const": "RECONCILIATION_FAILED"},
        "retry": {"const": "NEW_AUTHORITY_REQUIRED"}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replay_root", "checkpoint_root", "observation_root", "minimum_checkpoint_epoch", "monotonic_counter"],
      "properties": {
        "replay_root": {"$ref": "#/$defs/digest"},
        "checkpoint_root": {"$ref": "#/$defs/digest"},
        "observation_root": {"$ref": "#/$defs/digest"},
        "minimum_checkpoint_epoch": {"type": "integer", "minimum": 0},
        "monotonic_counter": {"type": "integer", "minimum": 0}
      }
    },
    "record_hash": {"$ref": "#/$defs/digest"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "role"],
      "properties": {
        "principal_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 80}
      }
    }
  }
}
