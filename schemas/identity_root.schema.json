{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/identity_root.schema.json",
  "title": "ProofRail Identity Root v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "record_id", "created_at", "principals", "separation_rules", "record_hash", "signature"],
  "properties": {
    "kind": {"const": "proofrail.identity-root.v0.2"},
    "record_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["principal_id", "role", "key_id", "public_key"],
        "properties": {
          "principal_id": {"type": "string", "minLength": 1},
          "role": {
            "enum": ["proposer", "learner", "verifier", "executor", "reconciler", "governor"]
          },
          "key_id": {"type": "string", "minLength": 1},
          "public_key": {"type": "string", "minLength": 40}
        }
      }
    },
    "separation_rules": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "previous_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 80}
      }
    }
  }
}
