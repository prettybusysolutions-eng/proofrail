{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/state_root.schema.json",
  "title": "ProofRail GitHub State Root v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "record_id", "created_at", "provider", "repository", "pull_number", "head_sha", "base_sha", "checks_digest", "reviews_digest", "branch_protection_digest", "record_hash", "signature"],
  "properties": {
    "kind": {"const": "proofrail.state-root.github.v0.2"},
    "record_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "provider": {"const": "github"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_number": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
    "checks_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviews_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "branch_protection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "previous_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 80}
      }
    }
  }
}
