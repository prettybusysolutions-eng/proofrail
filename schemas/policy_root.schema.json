{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofrail.dev/schemas/policy_root.schema.json",
  "title": "ProofRail Policy Root v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "record_id", "created_at", "policy_id", "policy_version", "rules_digest", "reason_codes", "promotion_authority", "record_hash", "signature"],
  "properties": {
    "kind": {"const": "proofrail.policy-root.v0.2"},
    "record_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "rules_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "promotion_authority": {"const": "governor"},
    "previous_hash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 80}
      }
    }
  }
}
